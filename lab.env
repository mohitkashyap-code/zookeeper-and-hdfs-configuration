# Lab settings. HDFS configs assume N=3 (zk1..zk3); ZooKeeper alone works with any N.
N=3
SUBNET_PREFIX=10.10.10
BRIDGE=zkbr0
ZK_VERSION=3.8.7
HADOOP_VERSION=3.5.0
DEBIAN_SUITE=bookworm
DEBIAN_MIRROR=http://deb.debian.org/debian
JAVA_HOME_IN_CONTAINER=/usr/lib/jvm/java-17-openjdk-amd64
CACHE=/var/cache/zk-lab
